# URL base pública de la API de backend (FastAPI local)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Origen de datos para la aplicación: 'api' para FastAPI o 'mock' para datos locales
VITE_DATA_SOURCE=api

# Compañía activa por defecto para demostración multitenant (EMP-01, EMP-02, EMP-03)
VITE_DEFAULT_COMPANY_ID=EMP-01
